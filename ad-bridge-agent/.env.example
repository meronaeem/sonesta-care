# ---------------------------------------------------------------
# Hotel IT Operations — AD Bridge Agent configuration
# Copy to `.env` and restrict file permissions to the service account.
# ---------------------------------------------------------------

# Port the agent listens on (put it behind IIS/nginx with a TLS certificate).
PORT=8443

# Shared secret. Must match the AD_BRIDGE_TOKEN secret configured in the
# web application. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AD_BRIDGE_TOKEN=change-me

# Password of the read-only Active Directory service account
# (the bind user configured in Administration -> Active Directory).
# This value NEVER leaves this machine and is never sent to the web app.
AD_BIND_PASSWORD=